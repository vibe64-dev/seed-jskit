{
  "name": "accounts-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Accounts hub: one sign-in for all of your apps, as an OpenID Connect issuer you own",
  "engines": {
    "node": "26.x"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "server": "node ./bin/server.js",
    "server:all": "node ./bin/server.js",
    "start": "node ./bin/server.js",
    "develop": "node ./bin/develop.js",
    "dev": "vite",
    "dev:all": "vite",
    "build": "vite build",
    "build:all": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "node --test --test-concurrency=1",
    "test:client": "vitest run tests/client",
    "test:e2e": "playwright test tests/e2e",
    "db:prepare": "node ./scripts/prepare-database.js",
    "db:migrate": "knex --knexfile ./knexfile.js migrate:latest",
    "db:migrate:rollback": "knex --knexfile ./knexfile.js migrate:rollback",
    "db:migrate:status": "knex --knexfile ./knexfile.js migrate:list",
    "jskit:update": "npx --yes @jskit-ai/jskit-catalog@latest update",
    "jskit:check": "jskit check",
    "verify": "npm run jskit:check && npm run lint && npm run test && npm run test:client && npm run build",
    "test:database": "node --test --test-concurrency=1 tests/server/hub-persistence.integration.js",
    "hub:keys:rotate": "jskit-oidc-issuer keys rotate",
    "hub:import": "jskit-oidc-issuer import-accounts"
  },
  "dependencies": {
    "@fastify/fast-json-stringify-compiler": "^5.1.0",
    "@fastify/static": "^10.1.4",
    "@jskit-ai/database-runtime-mysql": "0.1.242",
    "@jskit-ai/http-runtime": "0.1.242",
    "@jskit-ai/kernel": "0.1.244",
    "@jskit-ai/oidc-issuer-core": "0.1.0",
    "@jskit-ai/shell-web": "0.1.249",
    "@local/main": "0.1.0",
    "@mdi/js": "^7.4.47",
    "@tanstack/vue-query": "^5.103.1",
    "@vue/devtools-api": "^8.2.1",
    "fastify": "^5.12.5",
    "json-rest-schema": "^1.0.17",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "vuetify": "^4.2.1"
  },
  "devDependencies": {
    "@jskit-ai/config-eslint": "0.1.241",
    "@jskit-ai/jskit-catalog": "0.1.292",
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "eslint": "^10.11.0",
    "knex": "^3.3.0",
    "vite": "^8.3.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "vue-demi@0.14.10": true
  }
}
