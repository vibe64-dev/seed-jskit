{
  "name": "myapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "JSKIT shell-web app (Fastify + Vue)",
  "engines": {
    "node": "26.x"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "server": "node ./bin/server.js",
    "server:all": "node ./bin/server.js",
    "server:home": "SERVER_SURFACE=home node ./bin/server.js",
    "start": "node ./bin/server.js",
    "develop": "node ./bin/develop.js",
    "dev": "vite",
    "dev:all": "vite",
    "dev:home": "VITE_SURFACE=home vite",
    "build": "vite build",
    "build:all": "vite build",
    "build:home": "VITE_SURFACE=home vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "node --test --test-concurrency=1",
    "test:client": "vitest run tests/client",
    "test:e2e": "playwright test tests/e2e",
    "jskit:update": "npx --yes @jskit-ai/jskit-catalog@latest update",
    "jskit:check": "jskit check",
    "verify": "npm run jskit:check && npm run lint && npm run test && npm run test:client && npm run build"
  },
  "dependencies": {
    "@local/main": "0.1.0",
    "@fastify/static": "^10.1.4",
    "@jskit-ai/kernel": "0.1.211",
    "@tanstack/vue-query": "^5.103.1",
    "fastify": "^5.12.5",
    "json-rest-schema": "^1.0.17",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "vuetify": "^4.2.1",
    "@jskit-ai/http-runtime": "0.1.209",
    "@mdi/js": "^7.4.47",
    "@jskit-ai/shell-web": "0.1.215",
    "@fastify/fast-json-stringify-compiler": "^5.1.0",
    "@vue/devtools-api": "^8.2.1"
  },
  "devDependencies": {
    "@jskit-ai/config-eslint": "0.1.208",
    "@jskit-ai/jskit-catalog": "0.1.236",
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "eslint": "^10.11.0",
    "vite": "^8.3.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "vue-demi@0.14.10": true
  }
}
