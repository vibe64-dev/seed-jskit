# Database (MySQL or MariaDB)
DB_CLIENT=mysql2
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=accounts_hub
DB_USER=accounts_hub
DB_PASSWORD=replace-me

PORT=3001
# The hub's own address, which is its issuer. https outside this computer.
APP_PUBLIC_URL=http://localhost:3001

# At least 24 characters. Every app gets the same value as AUTH_OIDC_REGISTRATION_TOKEN.
OIDC_HUB_REGISTRATION_TOKEN=replace-with-a-long-random-token
# Your email. Once confirmed, this account opens Apps, People and Setup.
OIDC_HUB_OWNER_EMAIL=you@example.com

# Required in production: at least 32 random bytes. Development generates one in .jskit/oidc-hub/.
# OIDC_HUB_SECRET=
# Optional: https:// addresses approved automatically, for example preview addresses.
# OIDC_HUB_DEV_ORIGIN_PATTERNS=https://preview-*.example.com
# Required in production: your own email sender.
# OIDC_HUB_EMAIL_FROM=Accounts <accounts@example.com>
# RESEND_API_KEY=
# SMTP_URL=
# Optional: "Continue with Google" with your own Google OAuth client.
# OIDC_HUB_GOOGLE_CLIENT_ID=
# OIDC_HUB_GOOGLE_CLIENT_SECRET=
